# Copy this file to .env and fill in the values. Never commit or share .env.

# Azure OpenAI: Azure portal -> your Azure OpenAI resource -> Keys and Endpoint
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Deployment names on that resource: Azure AI Foundry -> Deployments
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_STT_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1-mini

# Which bot to run: "pipeline" (transcribe -> chat -> TTS) or "realtime" (one speech model)
BOT_MODE=pipeline

# Optional: TTS voice (alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse)
# TTS_VOICE=alloy
